@@ -1,2 +1,24 @@
+"""PhysTwin package exports.
+
+The original module eagerly imported the interactive training stack, including
+X11 keyboard and off-screen visualization dependencies.  Keep the simulation
+core importable on a headless evaluation node and load those optional exports
+only when requested.  This does not change the simulator or optimizer.
+"""
+
 from .model import SpringMassSystemWarp
-from .engine import InvPhyTrainerWarp, OptimizerCMA
+
+
+def __getattr__(name):
+    if name == "InvPhyTrainerWarp":
+        from .engine.trainer_warp import InvPhyTrainerWarp
+
+        return InvPhyTrainerWarp
+    if name == "OptimizerCMA":
+        from .engine.cma_optimize_warp import OptimizerCMA
+
+        return OptimizerCMA
+    raise AttributeError(name)
+
+
+__all__ = ("SpringMassSystemWarp", "InvPhyTrainerWarp", "OptimizerCMA")
